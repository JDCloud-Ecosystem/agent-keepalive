#!/bin/bash
# agent-keepalive in one command. install.sh links it as ~/.local/bin/keepalive.
#   keepalive                 menu
#   keepalive status          agents, logins, schedule and last runs
#   keepalive login [agent]   connect an agent (Claude: a token that lasts a year)
#   keepalive schedule        hours, days and which agents run
#   keepalive test            run every chosen agent now
#   keepalive log [agent]     recent runs
#   keepalive update          latest version, same settings
#   keepalive uninstall
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"
load_config
migrate_token

if [[ "${LANGUAGE:-es}" == "es" ]]; then
    T_TITLE="Sesiones automáticas de tus agentes"
    T_SCHEDULE="Horario"; T_AT="a las"; T_AND="y"; T_OFF="sin sesiones activas"
    T_EVERY_DAY="todos los días"; T_WEEKDAYS="de lunes a viernes"
    T_DAYS=("domingo" "lunes" "martes" "miércoles" "jueves" "viernes" "sábado")
    T_ON="en la sesión automática"; T_NOT_ON="fuera de la sesión automática"
    T_NOT_INSTALLED="no instalado"; T_NO_LOGIN="falta iniciar sesión"; T_LOGIN_OK="con sesión"
    T_YEAR="conectado por un año, hasta el"; T_LAST="último envío"; T_NEVER="todavía ninguno"
    T_RUN_OK="salió bien"; T_RUN_LIMIT="la ventana ya estaba abierta"; T_RUN_ERROR="falló"; T_FIX="para arreglarlo"
    T_RUN_WEEKLY="la cuenta llegó a su límite semanal"
    T_MENU="¿Qué quieres hacer?"; T_M_STATUS="Ver el estado"; T_M_LOGIN="Conectar un agente"
    T_M_SCHEDULE="Cambiar el horario y los agentes"; T_M_TEST="Probar ahora"; T_M_LOG="Ver el historial"
    T_M_UPDATE="Actualizar agent-keepalive"; T_WHICH="¿Qué agente conectas?"; T_UPDATED="Actualizado; tu horario sigue igual."
else
    T_TITLE="Your agents' automatic sessions"
    T_SCHEDULE="Schedule"; T_AT="at"; T_AND="and"; T_OFF="no sessions enabled"
    T_EVERY_DAY="every day"; T_WEEKDAYS="Monday to Friday"
    T_DAYS=("Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday")
    T_ON="in the automatic session"; T_NOT_ON="not in the automatic session"
    T_NOT_INSTALLED="not installed"; T_NO_LOGIN="needs a login"; T_LOGIN_OK="logged in"
    T_YEAR="connected for a year, until"; T_LAST="last run"; T_NEVER="none yet"
    T_RUN_OK="went fine"; T_RUN_LIMIT="the window was already open"; T_RUN_ERROR="failed"; T_FIX="to fix it"
    T_RUN_WEEKLY="the account reached its weekly limit"
    T_MENU="What do you want to do?"; T_M_STATUS="See the status"; T_M_LOGIN="Connect an agent"
    T_M_SCHEDULE="Change the schedule and agents"; T_M_TEST="Test now"; T_M_LOG="See the history"
    T_M_UPDATE="Update agent-keepalive"; T_WHICH="Which agent do you connect?"; T_UPDATED="Updated; your schedule stays the same."
fi

_hours() {
    local list=()
    [[ "$MORNING_ENABLED" == "true" ]] && list+=("$(printf '%02d:%02d' "$MORNING_HOUR" "$MORNING_MINUTE")")
    [[ "$AFTERNOON_ENABLED" == "true" ]] && list+=("$(printf '%02d:%02d' "$AFTERNOON_HOUR" "$AFTERNOON_MINUTE")")
    [[ "$NIGHT_ENABLED" == "true" ]] && list+=("$(printf '%02d:%02d' "$NIGHT_HOUR" "$NIGHT_MINUTE")")
    (( ${#list[@]} == 0 )) && { echo "$T_OFF"; return; }
    local days=() d when
    IFS=',' read -ra picked <<< "$WEEKDAYS"
    for d in "${picked[@]}"; do days+=("${T_DAYS[$d]}"); done
    case "$(printf '%s\n' "${picked[@]}" | sort -n | tr '\n' ',')" in
        "0,1,2,3,4,5,6,") when="$T_EVERY_DAY" ;;
        "1,2,3,4,5,") when="$T_WEEKDAYS" ;;
        *) when="$(_join "${days[@]}")" ;;
    esac
    echo "$T_AT $(_join "${list[@]}"), $when"
}

_join() {  # a, b and c
    local out="" i
    for (( i = 1; i <= $#; i++ )); do
        if (( i == 1 )); then out="${!i}"; elif (( i == $# )); then out="$out $T_AND ${!i}"; else out="$out, ${!i}"; fi
    done
    echo "$out"
}

_last_run() {
    local line when fix
    line=$(grep -sE '\] (OK|LIMIT|ERROR)' "$(agent_log "$1")" | tail -1)
    [[ -z "$line" ]] && { echo "$T_NEVER"; return; }
    when=$(echo "$line" | sed -E 's/^\[[0-9]{4}-([0-9]{2})-([0-9]{2}) ([0-9]{2}:[0-9]{2}).*/\2\/\1 \3/')
    case "$line" in
        *"] OK"*) echo "$when, $T_RUN_OK" ;;
        *"] LIMIT (weekly"*) echo "$when, $T_RUN_WEEKLY" ;;
        *"] LIMIT"*) echo "$when, $T_RUN_LIMIT" ;;
        *)
            fix=$(echo "$line" | sed -nE 's/.*run: ([^|]*).*/\1/p' | sed 's/ *$//')
            echo "$when, $T_RUN_ERROR${fix:+; $T_FIX: $fix}" ;;
    esac
}

status() {
    printf '\n\033[1;36m%s\033[0m\n' "$T_TITLE"
    printf '%s: %s\n\n' "$T_SCHEDULE" "$(_hours)"
    local agent state
    for agent in $AGENTS_KNOWN; do
        if ! agent_installed "$agent"; then
            [[ " $AGENTS " == *" $agent "* ]] || continue
            state="$T_NOT_INSTALLED"
        elif [[ "$agent" == "claude" && -s "$CLAUDE_TOKEN" ]]; then
            state="$T_YEAR $(date -d "$(cat "$CLAUDE_TOKEN.created" 2>/dev/null || date +%F) +1 year" '+%d/%m/%Y')"
        elif agent_logged_in "$agent"; then
            state="$T_LOGIN_OK"
        else
            state="$T_NO_LOGIN: $(agent_login_command "$agent")"
        fi
        if [[ " $AGENTS " == *" $agent "* ]]; then
            printf '\033[1;32m%-12s\033[0m %s, %s.\n             %s: %s\n' "$(agent_title "$agent")" "$T_ON" "$state" "$T_LAST" "$(_last_run "$agent")"
        else
            printf '\033[0;37m%-12s %s, %s.\033[0m\n' "$(agent_title "$agent")" "$T_NOT_ON" "$state"
        fi
    done
    echo ""
}

login() {
    local agent="${1:-}"
    if [[ -z "$agent" ]]; then
        local options=() a
        for a in $AGENTS_KNOWN; do agent_installed "$a" && options+=("$a" "$(agent_title "$a")"); done
        agent=$(whiptail --title "agent-keepalive" --menu "$T_WHICH" 15 50 6 "${options[@]}" 3>&1 1>&2 2>&3) || return 0
    fi
    case "$agent" in
        claude) exec "$SCRIPT_DIR/login.sh" ;;
        codex) exec codex login --device-auth ;;
        opencode) exec opencode auth login ;;
        *) echo "agent?: $AGENTS_KNOWN"; return 1 ;;
    esac
}

history() {
    local agent
    for agent in ${1:-$AGENTS}; do
        printf '\n\033[1;33m%s\033[0m\n' "$(agent_title "$agent")"
        grep -sE '\] (OK|LIMIT|ERROR)' "$(agent_log "$agent")" | tail -n 8 || echo "  $T_NEVER"
    done
    echo ""
}

update() {
    git -C "$SCRIPT_DIR" config core.fileMode false
    git -C "$SCRIPT_DIR" pull --ff-only -q && chmod +x "$SCRIPT_DIR"/*.sh "$SCRIPT_DIR/keepalive"
    write_crontab
    echo "$T_UPDATED"
}

menu() {
    if ! command -v whiptail >/dev/null 2>&1 || [[ ! -t 0 ]]; then status; return; fi
    local choice
    choice=$(whiptail --title "agent-keepalive" --menu "$T_MENU" 16 56 6 \
        status "$T_M_STATUS" login "$T_M_LOGIN" schedule "$T_M_SCHEDULE" test "$T_M_TEST" \
        log "$T_M_LOG" update "$T_M_UPDATE" 3>&1 1>&2 2>&3) || return 0
    "$0" "$choice"
}

case "${1:-}" in
    "") menu ;;
    status) status ;;
    login) login "${2:-}" ;;
    schedule) exec "$SCRIPT_DIR/update-schedule.sh" ;;
    test) exec "$SCRIPT_DIR/test.sh" ;;
    log|history) history "${2:-}" ;;
    update) update ;;
    install) exec "$SCRIPT_DIR/install.sh" ;;
    uninstall) exec "$SCRIPT_DIR/uninstall.sh" ;;
    -h|--help|help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "keepalive: unknown command ${1}. See: keepalive help"; exit 1 ;;
esac
