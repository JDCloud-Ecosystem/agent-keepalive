_hours() {
    local list=()
    [[ "$MORNING_ENABLED" == "true" ]] && list+=("$(printf '%02d:%02d' "$MORNING_HOUR" "$MORNING_MINUTE")")
    [[ "$AFTERNOON_ENABLED" == "true" ]] && list+=("$(printf '%02d:%02d' "$AFTERNOON_HOUR" "$AFTERNOON_MINUTE")")
    [[ "$NIGHT_ENABLED" == "true" ]] && list+=("$(printf '%02d:%02d' "$NIGHT_HOUR" "$NIGHT_MINUTE")")
    (( ${#list[@]} == 0 )) && { echo "$T_OFF"; return; }
    local days=() d when
    IFS=',' read -ra picked <<< "$WEEKDAYS"
    for d in "${picked[@]}"; do days+=("${T_DAYS[$d]}"); done
    case "$(printf '%s\n' "${picked[@]}" | sort -n | tr '\n' ',')" in
        "0,1,2,3,4,5,6,") when="$T_EVERY_DAY" ;;
        "1,2,3,4,5,") when="$T_WEEKDAYS" ;;
        *) when="$(_join "${days[@]}")" ;;
    esac
    echo "$T_AT $(_join "${list[@]}"), $when"
}

_join() {  # a, b and c
    local out="" i
    for (( i = 1; i <= $#; i++ )); do
        if (( i == 1 )); then out="${!i}"; elif (( i == $# )); then out="$out $T_AND ${!i}"; else out="$out, ${!i}"; fi
    done
    echo "$out"
}

_last_run() {  # prints "result|text", result being ok, limit, weekly, error or never
    local line when fix
    line=$(grep -sE '\] (OK|LIMIT|ERROR)' "$(agent_log "$1")" | tail -1)
    [[ -z "$line" ]] && { echo "never|$T_NEVER"; return; }
    when=$(echo "$line" | sed -E 's/^\[[0-9]{4}-([0-9]{2})-([0-9]{2}) ([0-9]{2}:[0-9]{2}).*/\2\/\1 \3/')
    case "$line" in
        *"] OK"*) echo "ok|$when, $T_RUN_OK" ;;
        *"] LIMIT (weekly"*) echo "weekly|$when, $T_RUN_WEEKLY" ;;
        *"] LIMIT"*) echo "limit|$when, $T_RUN_LIMIT" ;;
        *)
            fix=$(echo "$line" | sed -nE 's/.*run: ([^|]*).*/\1/p' | sed 's/ *$//')
            echo "error|$when, $T_RUN_ERROR${fix:+; $T_FIX: $fix}" ;;
    esac
}

_badge() {  # background color code, then the label: black text on a colored block
    printf '\033[30;%sm%s\033[0m' "$1" "$2"
}

# Who an agent is connected as: the email and plan when the agent keeps them, otherwise its provider.
# Claude's year token carries no account details, so for it this reads what login.sh wrote down.
_account() {
    if [[ "$1" == "claude" && -s "$CLAUDE_TOKEN" ]]; then
        cat "$CLAUDE_ACCOUNT" 2>/dev/null || echo "$T_UNKNOWN"
        return
    fi
    command -v python3 >/dev/null || return 0
    python3 - "$1" "$T_API_KEY" 2>/dev/null <<'PY'
import base64, json, os, sys
agent, api_key = sys.argv[1:3]
home = os.path.expanduser("~")


def load(path):
    try:
        return json.load(open(path))
    except Exception:
        return {}


def claims(token):
    try:
        body = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))
    except Exception:
        return {}


def with_plan(email, plan):
    return f"{email} ({plan.capitalize()})" if email and plan else email


if agent == "claude":
    email = (load(f"{home}/.claude.json").get("oauthAccount") or {}).get("emailAddress") or ""
    plan = (load(f"{home}/.claude/.credentials.json").get("claudeAiOauth") or {}).get("subscriptionType") or ""
    print(with_plan(email, plan))
elif agent == "codex":
    auth = load(os.path.join(os.environ.get("CODEX_HOME") or f"{home}/.codex", "auth.json"))
    found = claims((auth.get("tokens") or {}).get("id_token") or "")
    plan = (found.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type") or ""
    print(with_plan(found.get("email") or "", plan) or (api_key if auth.get("OPENAI_API_KEY") else ""))
elif agent == "opencode":
    auth = load(os.path.join(os.environ.get("XDG_DATA_HOME") or f"{home}/.local/share", "opencode", "auth.json"))
    names = {"opencode": "OpenCode Zen", "anthropic": "Anthropic", "openai": "OpenAI",
             "github-copilot": "GitHub Copilot", "google": "Google"}
    shown = []
    for provider, entry in auth.items():
        found = claims(entry.get("access") or "")
        detail = found.get("email") or (found.get("https://api.openai.com/profile") or {}).get("email") \
            or (api_key if entry.get("type") == "api" else "")
        shown.append(names.get(provider, provider) + (f", {detail}" if detail else ""))
    print("; ".join(shown))
PY
}

status() {
    printf '\n\033[1;36m%s\033[0m\n' "$T_TITLE"
    printf '%s: %s\n\n' "$T_SCHEDULE" "$(_hours)"
    local agent state ready run badge account
    for agent in $AGENTS_KNOWN; do
        ready=false
        if ! agent_installed "$agent"; then
            [[ " $AGENTS " == *" $agent "* ]] || continue
            state="$T_NOT_INSTALLED"
        elif [[ "$agent" == "claude" && -s "$CLAUDE_TOKEN" ]]; then
            state="$T_YEAR $(date -d "$(cat "$CLAUDE_TOKEN.created" 2>/dev/null || date +%F) +1 year" '+%d/%m/%Y')"
            ready=true
        elif agent_logged_in "$agent"; then
            state="$T_LOGIN_OK"
            ready=true
        else
            state="$T_NO_LOGIN: $(agent_login_command "$agent")"
        fi
        account=$(agent_installed "$agent" && agent_logged_in "$agent" && _account "$agent")
        if [[ " $AGENTS " != *" $agent "* ]]; then
            printf '%s \033[0;37m%-12s %s, %s.\n%24s%s: %s\033[0m\n' "$(_badge 47 "$T_B_OFF")" "$(agent_title "$agent")" \
                "$T_NOT_ON" "$state" "" "$T_ACCOUNT" "${account:-$T_NO_ACCOUNT}"
            continue
        fi
        run=$(_last_run "$agent")
        if ! agent_installed "$agent"; then
            badge=$(_badge 41 "$T_B_FAIL")
        elif [[ "$ready" == false ]]; then
            badge=$(_badge 41 "$T_B_LOGIN")
        else
            case "${run%%|*}" in
                error) badge=$(_badge 41 "$T_B_FAIL") ;;
                weekly) badge=$(_badge 43 "$T_B_LIMIT") ;;
                never) badge=$(_badge 46 "$T_B_WAIT") ;;
                *) badge=$(_badge 42 "$T_B_OK") ;;
            esac
        fi
        printf '%s \033[1m%-12s\033[0m %s, %s.\n%24s%s: %s\n%24s%s: %s\n' "$badge" "$(agent_title "$agent")" \
            "$T_ON" "$state" "" "$T_ACCOUNT" "${account:-$T_NO_ACCOUNT}" "" "$T_LAST" "${run#*|}"
    done
    echo ""
}

login() {
    local agent="${1:-}"
    if [[ -z "$agent" ]]; then
        local options=() a
        for a in $AGENTS_KNOWN; do agent_installed "$a" && options+=("$a" "$(agent_title "$a")"); done
        agent=$(whiptail --title "agent-keepalive" --menu "$T_WHICH" 15 50 6 "${options[@]}" 3>&1 1>&2 2>&3) || return 0
    fi
    case "$agent" in
        claude) exec "$SCRIPT_DIR/login.sh" ;;
        codex) exec codex login --device-auth ;;
        opencode) exec opencode auth login ;;
        *) echo "agent?: $AGENTS_KNOWN"; return 1 ;;
    esac
}

_yes() {  # s, sí, y or yes in any case; an empty answer counts as $1
    local answer
    read -r answer || answer=""
    [[ -z "$answer" ]] && { [[ "$1" == true ]]; return; }
    [[ "${answer,,}" =~ ^(s|si|sí|y|yes)$ ]]
}

# Removes what each agent keeps to stay signed in. Claude also loses its year token and the .bashrc lines
# that hand it to every new terminal. `opencode auth logout` only works with a terminal, so OpenCode's
# credentials file is removed directly; Codex and Claude get their own logout first and the file after,
# in case the command is missing or fails.
_close_session() {
    case "$1" in
        claude)
            rm -f "$CLAUDE_TOKEN" "$CLAUDE_TOKEN.created" "$CLAUDE_ACCOUNT" \
                "$SCRIPT_DIR/.claude-token" "$SCRIPT_DIR/.claude-token.created"
            sed -i '/# >>> agent-keepalive token >>>/,/# <<< agent-keepalive token <<</d' "$HOME/.bashrc" 2>/dev/null
            sed -i '/# >>> claude-keepalive token >>>/,/# <<< claude-keepalive token <<</d' "$HOME/.bashrc" 2>/dev/null
            agent_installed claude && env -u CLAUDE_CODE_OAUTH_TOKEN timeout 60 claude auth logout </dev/null >/dev/null 2>&1
            rm -f "$HOME/.claude/.credentials.json" ;;
        codex)
            agent_installed codex && timeout 60 codex logout </dev/null >/dev/null 2>&1
            rm -f "${CODEX_HOME:-$HOME/.codex}/auth.json" ;;
        opencode)
            rm -f "${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json" ;;
    esac
}

# An agent without a session fails every run, so it leaves the automatic session unless it is the last one.
_leave_schedule() {  # agent, whether --yes was given
    [[ " $AGENTS " == *" $1 "* ]] || return 0
    local rest
    rest=$(echo " $AGENTS " | sed "s/ $1 / /" | xargs)
    if [[ -z "$rest" ]]; then
        printf "$T_ONLY_ONE\n" "$(agent_title "$1")"
        return 0
    fi
    if [[ "$2" == false ]]; then
        printf "$T_ASK_LEAVE" "$(agent_title "$1")"
        _yes true || { printf "$T_STAYS\n" "$(agent_title "$1")"; return 0; }
    fi
    set_config AGENTS "\"$rest\""
    write_crontab
    printf "$T_LEFT\n" "$(agent_title "$1")"
}

# Exit codes: 0 when the agent has no session here any more (closed now, or it had none), 1 for an unknown
# agent, a missing name without a terminal or credentials that could not be removed, 2 when the person says no.
logout() {
    local agent="" yes=false arg account
    for arg in "$@"; do
        case "$arg" in
            --yes|-y) yes=true ;;
            *) [[ -z "$agent" ]] && agent="$arg" ;;
        esac
    done
    if [[ -z "$agent" ]]; then
        local options=() a
        for a in $AGENTS_KNOWN; do agent_logged_in "$a" && options+=("$a" "$(agent_title "$a")"); done
        (( ${#options[@]} )) || { echo "$T_NONE_IN"; return 0; }
        if ! command -v whiptail >/dev/null 2>&1 || [[ ! -t 0 ]]; then echo "$T_NAME_IT"; return 1; fi
        agent=$(whiptail --title "agent-keepalive" --menu "$T_WHICH_OUT" 15 50 6 "${options[@]}" 3>&1 1>&2 2>&3) || return 2
    fi
    [[ " $AGENTS_KNOWN " == *" $agent "* ]] || { echo "agent?: $AGENTS_KNOWN"; return 1; }
    if ! agent_logged_in "$agent"; then
        printf "$T_NO_SESSION\n" "$(agent_title "$agent")"
        return 0
    fi
    account=$(_account "$agent")
    [[ "$account" == "$T_UNKNOWN" ]] && account=""
    if [[ "$yes" == false ]]; then
        if [[ -n "$account" ]]; then
            printf "$T_CONFIRM" "$(agent_title "$agent")" "$account"
        else
            printf "$T_CONFIRM_BARE" "$(agent_title "$agent")"
        fi
        _yes false || { echo "$T_CANCELLED"; return 2; }
    fi
    _close_session "$agent"
    if agent_logged_in "$agent"; then
        printf "\033[1;31m$T_STILL\033[0m\n" "$(agent_title "$agent")"
        return 1
    fi
    printf "\033[1;32m$T_LOGGED_OUT\033[0m\n" "$(agent_title "$agent")"
    [[ "$agent" == "claude" ]] && echo "$T_UNSET"
    _leave_schedule "$agent" "$yes"
    return 0
}

history() {
    local agent
    for agent in ${1:-$AGENTS}; do
        printf '\n\033[1;33m%s\033[0m\n' "$(agent_title "$agent")"
        grep -sE '\] (OK|LIMIT|ERROR)' "$(agent_log "$agent")" | tail -n 8 \
            | sed -E $'s/\\] OK/] \e[1;32mOK\e[0m/; s/\\] LIMIT/] \e[1;33mLIMIT\e[0m/; s/\\] ERROR/] \e[1;31mERROR\e[0m/' \
            || echo "  $T_NEVER"
    done
    echo ""
}

update() {
    git -C "$SCRIPT_DIR" config core.fileMode false
    git -C "$SCRIPT_DIR" pull --ff-only -q && chmod +x "$SCRIPT_DIR"/*.sh "$SCRIPT_DIR/keepalive"
    write_crontab
    echo "$T_UPDATED"
}

menu() {
    if ! command -v whiptail >/dev/null 2>&1 || [[ ! -t 0 ]]; then status; return; fi
    local choice
    choice=$(whiptail --title "agent-keepalive" --menu "$T_MENU" 17 56 7 \
        status "$T_M_STATUS" login "$T_M_LOGIN" logout "$T_M_LOGOUT" schedule "$T_M_SCHEDULE" \
        test "$T_M_TEST" log "$T_M_LOG" update "$T_M_UPDATE" 3>&1 1>&2 2>&3) || return 0
    "$0" "$choice"
}

case "${1:-}" in
    "") menu ;;
    status) status ;;
    login) login "${2:-}" ;;
    logout) shift; logout "$@"; exit $? ;;
    schedule) exec "$SCRIPT_DIR/update-schedule.sh" ;;
    test) exec "$SCRIPT_DIR/test.sh" ;;
    log|history) history "${2:-}" ;;
    update) update ;;
    install) exec "$SCRIPT_DIR/install.sh" ;;
    uninstall) exec "$SCRIPT_DIR/uninstall.sh" ;;
    -h|--help|help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "keepalive: unknown command ${1}. See: keepalive help"; exit 1 ;;
esac
