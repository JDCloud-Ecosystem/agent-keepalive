#!/bin/bash
# agent-keepalive in one command. install.sh links it as ~/.local/bin/keepalive.
#   keepalive                 the menu, with every option and a terminal
#   keepalive status          agents, accounts, schedule, next send and last runs
#   keepalive login [agent]   connect an agent (Claude: a token that lasts a year)
#   keepalive logout [agent]  close an agent's session on this machine (--yes skips the questions)
#   keepalive schedule        days, hours and which agents run
#   keepalive test            run every chosen agent now
#   keepalive log [agent]     recent runs
#   keepalive update [--yes]  latest agent-keepalive, same settings; shows what the new version changes first
#   keepalive changelog       what each version changed, the installed one first
#   keepalive update-agents   latest Claude Code, Codex and OpenCode, same logins
#   keepalive uninstall
#   keepalive migrate         run by an update with the new code, so what the install keeps is up to date
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"
load_config
migrate_token

SEP=$'\x1f'  # splits the cells of a table row
DAY=86400
RENEW_DAYS=30  # how long before the year token ends the menu starts saying so
CHANGES_WIDTH=42   # the Cambio column, so a table of changes fits a 72-column terminal
CHANGES_VERSIONS=5 # versions one table of changes shows at most

