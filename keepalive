# ── Status ────────────────────────────────────────────────────────────────────
_last_run() {  # prints "result|when|what", result being ok, limit, weekly, error or never
    local line
    line=$(grep -sE '\] (OK|LIMIT|ERROR)' "$(agent_log "$1")" | tail -1)
    [[ -z "$line" ]] && { echo "never||$T_NEVER"; return; }
    describe_run "$line"
}

# Who an agent is connected as: the email and plan when the agent keeps them, otherwise its provider.
# Claude's year token carries no account details, so for it this reads what login.sh wrote down.
_account() {
    if [[ "$1" == "claude" && -s "$CLAUDE_TOKEN" ]]; then
        cat "$CLAUDE_ACCOUNT" 2>/dev/null || echo "$T_UNKNOWN"
        return
    fi
    command -v python3 >/dev/null || return 0
    python3 - "$1" "$T_API_KEY" 2>/dev/null <<'PY'
import base64, json, os, sys
agent, api_key = sys.argv[1:3]
home = os.path.expanduser("~")


def load(path):
    try:
        return json.load(open(path))
    except Exception:
        return {}


def claims(token):
    try:
        body = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))
    except Exception:
        return {}


def with_plan(email, plan):
    return f"{email} ({plan.capitalize()})" if email and plan else email


if agent == "claude":
    email = (load(f"{home}/.claude.json").get("oauthAccount") or {}).get("emailAddress") or ""
    plan = (load(f"{home}/.claude/.credentials.json").get("claudeAiOauth") or {}).get("subscriptionType") or ""
    print(with_plan(email, plan))
elif agent == "codex":
    auth = load(os.path.join(os.environ.get("CODEX_HOME") or f"{home}/.codex", "auth.json"))
    found = claims((auth.get("tokens") or {}).get("id_token") or "")
    plan = (found.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type") or ""
    print(with_plan(found.get("email") or "", plan) or (api_key if auth.get("OPENAI_API_KEY") else ""))
elif agent == "opencode":
    auth = load(os.path.join(os.environ.get("XDG_DATA_HOME") or f"{home}/.local/share", "opencode", "auth.json"))
    names = {"opencode": "OpenCode Zen", "anthropic": "Anthropic", "openai": "OpenAI",
             "github-copilot": "GitHub Copilot", "google": "Google"}
    shown = []
    for provider, entry in auth.items():
        entry = entry if isinstance(entry, dict) else {}
        found = claims(entry.get("access") or "")
        detail = found.get("email") or (found.get("https://api.openai.com/profile") or {}).get("email") \
            or (api_key if entry.get("type") == "api" else "")
        shown.append(names.get(provider, provider) + (f" ({detail})" if detail else ""))
    print(", ".join(shown))
PY
}

# Every agent in one table, with its tag, name, session, account and last send, and below it one line for each
# agent that needs something done. With "brief", as in the menu, the session column goes, an agent outside the
# automatic session shows only when it has a session, and a fix points to the menu option instead of a command.
_agents_table() {  # full|brief
    local mode="$1" agent title tag color session account last run result when what fix until ends notes=() rows=()
    for agent in $AGENTS_KNOWN; do
        title=$(agent_title "$agent")
        local in=false ready=false
        [[ " $AGENTS " == *" $agent "* ]] && in=true
        if ! agent_installed "$agent"; then
            [[ "$in" == true ]] || continue
            tag="$T_B_FAIL" color="$C_RED" session="$T_NOT_INSTALLED" account="" last=""
            notes+=("$C_RED$(printf "$T_N_MISSING" "$title" "$(agent_package "$agent")")$C_RESET")
        else
            if [[ "$agent" == claude && -s "$CLAUDE_TOKEN" ]]; then
                ends=$(date -d "$(cat "$CLAUDE_TOKEN.created" 2>/dev/null || date +%F) +1 year" +%s)
                until=$(date -d "@$ends" '+%d/%m/%Y')
                session="$T_YEAR $until" ready=true
                (( ends - $(date +%s) < RENEW_DAYS * DAY )) && notes+=("$C_YELLOW$(printf "$T_N_RENEW" "$until")$C_RESET")
            elif agent_logged_in "$agent"; then
                session="$T_LOGIN_OK" ready=true
            else
                session="$T_NO_LOGIN"
            fi
            account=""
            [[ "$ready" == true ]] && account=$(_account "$agent") && account="${account:-$T_NO_ACCOUNT}"
            if [[ "$in" == false ]]; then
                [[ "$mode" == brief && "$ready" == false ]] && continue
                tag="$T_B_OFF" color="$C_DIM" last="$T_NOT_ON"
            elif [[ "$ready" == false ]]; then
                tag="$T_B_LOGIN" color="$C_RED" last=""
                if [[ "$mode" == brief ]]; then
                    notes+=("$C_RED$(printf "$T_N_LOGIN_MENU" "$title")$C_RESET")
                else
                    notes+=("$C_RED$(printf "$T_N_LOGIN_CMD" "$title" "$(agent_login_command "$agent")")$C_RESET")
                fi
            else
                run=$(_last_run "$agent")
                result="${run%%|*}" when="${run#*|}" when="${when%%|*}" what="${run##*|}"
                last="${when:+$when, }${what%%, *}"
                case "$result" in
                    error)
                        tag="$T_B_FAIL" color="$C_RED"
                        fix="${what#*"$U_FIX "}"
                        if [[ "$what" == "$U_RUN_SILENT" ]]; then
                            notes+=("$C_RED$(printf "$T_N_SILENT" "$title")$C_RESET")
                        elif [[ "$fix" == "$what" ]]; then
                            notes+=("$C_RED$(printf "$T_N_FAILED" "$title")$C_RESET")
                        elif [[ "$mode" == brief && "$fix" == *login* ]]; then
                            notes+=("$C_RED$(printf "$T_N_RELOGIN_MENU" "$title")$C_RESET")
                        else
                            notes+=("$C_RED$(printf "$T_N_FIX" "$title" "$fix")$C_RESET")
                        fi ;;
                    weekly) tag="$T_B_LIMIT" color="$C_YELLOW"
                            notes+=("$C_YELLOW$(printf "$T_N_WEEKLY" "$title")$C_RESET") ;;
                    never) tag="$T_B_WAIT" color="$C_CYAN" ;;
                    *) tag="$T_B_OK" color="$C_GREEN" ;;
                esac
            fi
        fi
        if [[ "$mode" == brief ]]; then
            rows+=("$color$tag$C_RESET$SEP$title$SEP$C_DIM$account$C_RESET$SEP$last")
        else
            rows+=("$color$tag$C_RESET$SEP$title$SEP$session$SEP$C_DIM$account$C_RESET$SEP$last")
        fi
    done
    {
        if [[ "$mode" == brief ]]; then
            printf '%s\n' "$T_H_STATE$SEP$T_H_AGENT$SEP$T_H_ACCOUNT$SEP$T_H_LAST"
        else
            printf '%s\n' "$T_H_STATE$SEP$T_H_AGENT$SEP$T_H_SESSION$SEP$T_H_ACCOUNT$SEP$T_H_LAST"
        fi
        (( ${#rows[@]} )) && printf '%s\n' "${rows[@]}"
    } | ui_table
    (( ${#notes[@]} )) && printf '  %s\n' "${notes[@]}"
    return 0
}

_overview() {  # full|brief
    local next version newer
    ui_section "$T_TITLE"
    next=$(next_run_text) || next="$T_NEXT_NONE"
    version=$(installed_version) || version="$T_NO_NUMBER"
    newer=$(newer_version) && version+="$C_YELLOW, $(printf "$T_V_NEWER" "$newer")$C_RESET"
    printf '\n  %s%s\n  %s%s\n  %s%s\n\n' "$T_SCHEDULE" "$(schedule_text)" "$T_NEXT" "$next" "$T_VERSION" "$version"
    _agents_table "$1"
}

status() {
    _overview full
    echo ""
}

# ── Accounts ──────────────────────────────────────────────────────────────────
_login_state() {
    local account
    if ! agent_logged_in "$1"; then echo "$T_NO_LOGIN"; return; fi
    account=$(_account "$1")
    echo "$T_LOGIN_OK${account:+, $account}"
}

# Draws the agents of one kind with their state and sets PICKED to the one chosen; returns BACK on 0.
_pick_agent() {  # title, installed|logged_in
    local options=() a n
    for a in $AGENTS_KNOWN; do
        case "$2" in
            installed) agent_installed "$a" ;;
            logged_in) agent_logged_in "$a" ;;
        esac && options+=("$a")
    done
    (( ${#options[@]} )) || return 1
    while true; do
        ui_clear
        ui_section "$1"
        echo ""
        n=0
        for a in "${options[@]}"; do
            n=$(( n + 1 ))
            ui_option "$n" "$(printf '%-12s  %s' "$(agent_title "$a")" "$(_login_state "$a")")"
        done
        echo ""
        ui_option 0 "$U_BACK"
        ui_choose "$T_PICK_AGENT" "${#options[@]}" text || return "$BACK"
        [[ "$ANSWER" == 0 ]] && return "$BACK"
        if [[ "$ANSWER" =~ ^[0-9]+$ ]] && (( ANSWER >= 1 && ANSWER <= ${#options[@]} )); then
            PICKED="${options[ANSWER - 1]}"
            return 0
        fi
        for a in "${options[@]}"; do [[ "${ANSWER,,}" == "$a" ]] && { PICKED="$a"; return 0; }; done
    done
}

# A newly connected agent outside the automatic session is offered a place in it.
_join_schedule() {
    [[ " $AGENTS " == *" $1 "* ]] && return 0
    ui_yes "$(printf "$T_ASK_JOIN" "$(agent_title "$1")")" true || return 0
    set_config AGENTS "\"$AGENTS $1\""
    write_crontab
    ui_ok "$(printf "$T_JOINED" "$(agent_title "$1")")"
}

login() {
    local agent="${1:-}" account
    if [[ -z "$agent" ]]; then
        [[ -t 0 ]] || { echo "$T_NAME_LOGIN"; return 1; }
        _pick_agent "$T_LOGIN_TITLE" installed || return
        agent="$PICKED"
        ui_clear
    fi
    [[ " $AGENTS_KNOWN " == *" $agent "* ]] || { printf "$T_UNKNOWN_AGENT\n" "$agent"; return 1; }
    if ! agent_installed "$agent"; then
        ui_fail "$(printf "$T_MISSING" "$(agent_title "$agent")" "$(agent_package "$agent")")"
        return 1
    fi
    if [[ "$agent" == claude ]]; then
        bash "$SCRIPT_DIR/login.sh" || return 1
    else
        ui_section "$(printf "$T_CONNECT_TITLE" "$(agent_title "$agent" | tr '[:lower:]' '[:upper:]')")"
        printf '\n  %s\n\n' "$T_CONNECT_STEPS"
        case "$agent" in
            codex) codex login --device-auth ;;
            opencode) opencode auth login ;;
        esac
        echo ""
        if ! agent_logged_in "$agent"; then
            ui_warn "$(printf "$T_NOT_CONNECTED" "$(agent_title "$agent")")"
            return 1
        fi
        account=$(_account "$agent")
        ui_ok "$(printf "$T_CONNECTED" "$(agent_title "$agent")")${account:+, $account}."
    fi
    agent_logged_in "$agent" && _join_schedule "$agent"
    return 0
}

# Removes what each agent keeps to stay signed in. Claude also loses its year token and the .bashrc lines
# that hand it to every new terminal. `opencode auth logout` only works with a terminal, so OpenCode's
# credentials file is removed directly; Codex and Claude get their own logout first and the file after,
# in case the command is missing or fails.
_close_session() {
    case "$1" in
        claude)
            rm -f "$CLAUDE_TOKEN" "$CLAUDE_TOKEN.created" "$CLAUDE_ACCOUNT" \
                "$SCRIPT_DIR/.claude-token" "$SCRIPT_DIR/.claude-token.created"
            sed -i '/# >>> agent-keepalive token >>>/,/# <<< agent-keepalive token <<</d' "$HOME/.bashrc" 2>/dev/null
            sed -i '/# >>> claude-keepalive token >>>/,/# <<< claude-keepalive token <<</d' "$HOME/.bashrc" 2>/dev/null
            agent_installed claude && env -u CLAUDE_CODE_OAUTH_TOKEN timeout 60 claude auth logout </dev/null >/dev/null 2>&1
            rm -f "$HOME/.claude/.credentials.json" ;;
        codex)
            agent_installed codex && timeout 60 codex logout </dev/null >/dev/null 2>&1
            rm -f "${CODEX_HOME:-$HOME/.codex}/auth.json" ;;
        opencode)
            rm -f "${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json" ;;
    esac
}

# An agent without a session fails every run, so it leaves the automatic session unless it is the last one.
_leave_schedule() {  # agent, whether --yes was given
    [[ " $AGENTS " == *" $1 "* ]] || return 0
    local rest
    rest=$(echo " $AGENTS " | sed "s/ $1 / /" | xargs)
    if [[ -z "$rest" ]]; then
        ui_note "$(printf "$T_ONLY_ONE" "$(agent_title "$1")")"
        return 0
    fi
    if [[ "$2" == false ]]; then
        ui_yes "$(printf "$T_ASK_LEAVE" "$(agent_title "$1")")" true \
            || { ui_note "$(printf "$T_STAYS" "$(agent_title "$1")")"; return 0; }
    fi
    set_config AGENTS "\"$rest\""
    write_crontab
    ui_ok "$(printf "$T_LEFT" "$(agent_title "$1")")"
}

# Exit codes: 0 when the agent has no session here any more (closed now, or it had none), 1 for an unknown
# agent, a missing name without a terminal or credentials that could not be removed, 2 when the person says no,
# and BACK when they went back from the list.
logout() {
    local agent="" yes=false arg account question
    for arg in "$@"; do
        case "$arg" in
            --yes|-y) yes=true ;;
            *) [[ -z "$agent" ]] && agent="$arg" ;;
        esac
    done
    if [[ -z "$agent" ]]; then
        [[ -t 0 ]] || { echo "$T_NAME_IT"; return 1; }
        _pick_agent "$T_LOGOUT_TITLE" logged_in
        case $? in
            0) agent="$PICKED" ;;
            1) ui_note "$T_NONE_IN"; return 0 ;;
            *) return "$BACK" ;;
        esac
    fi
    [[ " $AGENTS_KNOWN " == *" $agent "* ]] || { printf "$T_UNKNOWN_AGENT\n" "$agent"; return 1; }
    if ! agent_logged_in "$agent"; then
        ui_note "$(printf "$T_NO_SESSION" "$(agent_title "$agent")")"
        return 0
    fi
    account=$(_account "$agent")
    [[ "$account" == "$T_UNKNOWN" ]] && account=""
    if [[ "$yes" == false ]]; then
        if [[ -n "$account" ]]; then
            question=$(printf "$T_CONFIRM" "$(agent_title "$agent")" "$account")
        else
            question=$(printf "$T_CONFIRM_BARE" "$(agent_title "$agent")")
        fi
        ui_yes "$question" false || { ui_note "$T_CANCELLED"; return 2; }
    fi
    _close_session "$agent"
    if agent_logged_in "$agent"; then
        ui_fail "$(printf "$T_STILL" "$(agent_title "$agent")")"
        return 1
    fi
    ui_ok "$(printf "$T_LOGGED_OUT" "$(agent_title "$agent")")"
    [[ "$agent" == "claude" ]] && ui_note "$T_UNSET"
    _leave_schedule "$agent" "$yes"
    return 0
}

# ── History ───────────────────────────────────────────────────────────────────
# The last runs of each agent in one table, a group of rows per agent. A failure shows its fix, or else what
# the agent answered.
history() {
    local agent line runs run result when what tag first rows=()
    ui_section "$T_LOG_TITLE"
    echo ""
    for agent in ${1:-$AGENTS}; do
        (( ${#rows[@]} )) && rows+=("--")
        first=$(agent_title "$agent")
        runs=$(grep -sE '\] (OK|LIMIT|ERROR)' "$(agent_log "$agent")" | tail -n 8)
        if [[ -z "$runs" ]]; then
            rows+=("$first$SEP$SEP$SEP$C_DIM$T_NEVER$C_RESET")
            continue
        fi
        while IFS= read -r line; do
            run=$(describe_run "$line")
            result="${run%%|*}" when="${run#*|}" when="${when%%|*}" what="${run##*|}"
            case "$result" in
                ok) tag="$C_GREEN$T_R_OK$C_RESET" ;;
                error) tag="$C_RED$T_R_ERROR$C_RESET"
                       if [[ "$what" == "$U_RUN_ERROR" ]]; then
                           what=$(sed -E 's/^[^]]*\] \[[A-Z]+\] ERROR[^:]*: *//' <<< "$line" | cut -c1-70)
                       else
                           what="${what#"$U_RUN_ERROR, "}"
                       fi ;;
                *) tag="$C_YELLOW$T_R_LIMIT$C_RESET" ;;
            esac
            rows+=("$first$SEP$when$SEP$tag$SEP$what")
            first=""
        done <<< "$runs"
    done
    { printf '%s\n' "$T_H_AGENT$SEP$T_H_WHEN$SEP$T_H_RESULT$SEP$T_H_WHAT"; printf '%s\n' "${rows[@]}"; } | ui_table
    echo ""
}

# ── Updates ───────────────────────────────────────────────────────────────────
# The words of a text in lines of at most width characters.
_wrap() {  # text, width
    local LC_ALL=C.UTF-8 line="" word words=()
    read -ra words <<< "$1"
    for word in "${words[@]}"; do
        if [[ -z "$line" ]]; then
            line="$word"
        elif (( ${#line} + 1 + ${#word} <= $2 )); then
            line+=" $word"
        else
            printf '%s\n' "$line"
            line="$word"
        fi
    done
    [[ -n "$line" ]] && printf '%s\n' "$line"
    return 0
}

# Each change of a CHANGELOG.md on standard input as version, date, kind and text split by SEP, newest version
# first. Release Please writes one line per change, under a heading per kind; a version written by hand is one
# paragraph, kind text. The links to the pull request and the commit are left out.
_changelog_entries() {
    awk -v sep="$SEP" '
        function flush() { if (ver != "" && prose != "") print ver sep date sep "text" sep prose; prose = "" }
        /^## / {
            flush()
            ver = $0; sub(/^## \[?/, "", ver); sub(/[] (].*$/, "", ver)
            date = ""
            if (match($0, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/)) date = substr($0, RSTART, RLENGTH)
            kind = "text"; next
        }
        /^### / {
            flush(); s = substr($0, 5)
            if (s == "Features") kind = "feat"
            else if (s == "Bug Fixes") kind = "fix"
            else if (s ~ /^Performance/) kind = "perf"
            else if (s ~ /BREAKING/) kind = "breaking"
            else kind = "other"
            next
        }
        ver == "" { next }
        /^[*-] / {
            t = substr($0, 3)
            gsub(/ \(\[[^]]*\]\([^)]*\)\)/, "", t)
            sub(/^\*\*[^*]*:\*\* /, "", t)
            print ver sep date sep kind sep t; next
        }
        kind == "text" && NF { prose = prose (prose == "" ? "" : " ") $0 }
        END { flush() }'
}

# A table with what each version changed, from a CHANGELOG.md on standard input: the versions after the first
# argument (all when empty) up to the second (all when empty), newest first, CHANGES_VERSIONS at most. Changes a
# person does not notice (docs, CI, refactors) become one Interno row when they are all a version has.
_changes_table() {  # after, up_to
    local after="$1" upto="$2" entries=() entry ver date kind words label version="" day="" versions=0 more=false
    local rows=() pending=() hidden=false first line
    mapfile -t entries < <(_changelog_entries)
    _flush_version() {
        [[ -z "$version" ]] && return 0
        (( ${#pending[@]} )) || { [[ "$hidden" == true ]] && pending=("$T_K_INTERNAL$SEP$T_INTERNAL"); }
        (( ${#pending[@]} )) || return 0
        (( versions )) && rows+=("--")
        first=true
        for entry in "${pending[@]}"; do
            label="${entry%%"$SEP"*}"
            while IFS= read -r line; do
                if [[ "$first" == true ]]; then
                    rows+=("$C_BOLD$version$C_RESET$SEP$label$SEP$line"); first=second
                elif [[ "$first" == second ]]; then
                    rows+=("$C_DIM$day$C_RESET$SEP$label$SEP$line"); first=false
                else
                    rows+=("$SEP$label$SEP$line")
                fi
                label=""
            done < <(_wrap "${entry#*"$SEP"}" "$CHANGES_WIDTH")
        done
        [[ "$first" == second && -n "$day" ]] && rows+=("$C_DIM$day$C_RESET$SEP$SEP")
        versions=$(( versions + 1 ))
    }
    for entry in "${entries[@]}"; do
        IFS="$SEP" read -r ver date words <<< "$entry"
        kind="${words%%"$SEP"*}" words="${words#*"$SEP"}"
        if [[ "$ver" != "$version" ]]; then
            _flush_version
            version="" pending=() hidden=false
            [[ -n "$after" ]] && ! version_newer "$ver" "$after" && continue
            [[ -n "$upto" ]] && version_newer "$ver" "$upto" && continue
            (( versions >= CHANGES_VERSIONS )) && { more=true; continue; }
            version="$ver" day=""
            [[ -n "$date" ]] && day=$(date -d "$date" '+%d/%m/%Y' 2>/dev/null || echo "$date")
        fi
        case "$kind" in
            feat) pending+=("$T_K_FEAT$SEP$words") ;;
            fix) pending+=("$T_K_FIX$SEP$words") ;;
            perf) pending+=("$T_K_PERF$SEP$words") ;;
            breaking) pending+=("$C_YELLOW$T_K_BREAKING$C_RESET$SEP$words") ;;
            text) pending+=("$T_K_TEXT$SEP$words") ;;
            *) hidden=true ;;
        esac
    done
    _flush_version
    if (( ${#rows[@]} == 0 )); then ui_note "$T_CL_NONE"; return 0; fi
    { printf '%s\n' "$T_H_VERSION$SEP$T_H_KIND$SEP$T_H_CHANGE"; printf '%s\n' "${rows[@]}"; } | ui_table
    [[ "$more" == true ]] && ui_note "$T_CL_MORE"
    return 0
}

_version() {
    printf '%s (%s)' "$(installed_version || echo "$T_NO_NUMBER")" \
        "$(git -C "$SCRIPT_DIR" log -1 --format=%h 2>/dev/null || echo "?")"
}

# Brings the clone to origin/main: a fast-forward when it can, and when main was rewritten with the same files
# (HEAD's tree is somewhere in main's history), a reset onto it. Hand edits to tracked files go to the stash
# first and set STASHED. Returns 2, with everything as it was, when the clone has commits of its own, and 1 with
# git's answer in MOVE_ERROR when git fails.
_move_to_main() {
    local git=(git -C "$SCRIPT_DIR") tree trees
    MOVE_ERROR=""
    "${git[@]}" config core.fileMode false
    if [[ -n "$("${git[@]}" status --porcelain --untracked-files=no)" ]]; then
        MOVE_ERROR=$("${git[@]}" stash push -q -m "agent-keepalive, before updating on $(date +%F)" 2>&1) || return 1
        STASHED=yes
    fi
    MOVE_ERROR=$("${git[@]}" merge -q --ff-only origin/main 2>&1) && return 0
    tree=$("${git[@]}" rev-parse 'HEAD^{tree}')
    trees=$("${git[@]}" log --format=%T origin/main)
    if grep -qx "$tree" <<< "$trees"; then
        MOVE_ERROR=$("${git[@]}" reset -q --hard origin/main 2>&1) && return 0
        return 1
    fi
    if [[ -n "$STASHED" ]]; then "${git[@]}" stash pop -q && STASHED=""; fi
    return 2
}

# Looks for a new version, shows what it changes and asks before updating; --yes, or no terminal, skips the
# question. Returns 0 when a new version came in, 3 when there was nothing to do or the person said no, and 1
# when it could not update.
update() {  # [--yes]
    local before after current latest answer
    ui_section "$T_UPDATE_TITLE"
    printf '\n  %s\n' "$T_LOOKING"
    if ! answer=$(check_update 2>&1); then
        ui_fail "$T_FETCH_FAILED"
        [[ -n "$answer" ]] && printf '%s\n' "$answer" | tail -n 3 | sed 's/^/    /'
        return 1
    fi
    if [[ "$(git -C "$SCRIPT_DIR" rev-parse 'HEAD^{tree}' 2>/dev/null)" \
          == "$(git -C "$SCRIPT_DIR" rev-parse 'origin/main^{tree}' 2>/dev/null)" ]]; then
        # The same files, perhaps under a rewritten history; the clone follows main again without touching them.
        [[ -z "$(git -C "$SCRIPT_DIR" status --porcelain --untracked-files=no)" ]] && STASHED="" && _move_to_main
        write_crontab  # a hand edit of config.sh reaches the cron with an update, as it always has
        ui_ok "$(printf "$T_UP_TO_DATE" "$(_version)")"
        return 3
    fi
    if [[ "$(git -C "$SCRIPT_DIR" rev-list --count HEAD..origin/main 2>/dev/null)" == 0 ]]; then
        write_crontab
        ui_ok "$(printf "$T_UP_TO_DATE" "$(_version)")"  # main has nothing this copy lacks
        return 3
    fi
    current=$(installed_version) latest=$(latest_version)
    if version_newer "$latest" "$current"; then
        if [[ -n "$current" ]]; then
            printf '\n  %s\n\n' "$(printf "$T_NEW_VERSION" "$latest" "$current")"
        else
            printf '\n  %s\n\n' "$(printf "$T_NEW_VERSION_BARE" "$latest")"
        fi
        git -C "$SCRIPT_DIR" show origin/main:CHANGELOG.md 2>/dev/null | _changes_table "$current" "$latest"
        ui_note "$T_CL_NOTE"
    else
        printf '\n  %s\n' "$T_NEW_CHANGES"
    fi
    if [[ "${1:-}" != --yes && -t 0 ]]; then
        ui_yes "$T_ASK_UPDATE" false || { ui_note "$T_NOT_UPDATED"; return 3; }
    fi
    before=$(_version)
    STASHED=""
    _move_to_main
    case $? in
        0) ;;
        2) ui_fail "$T_OWN_COMMITS"; return 1 ;;
        *) ui_fail "$T_UPDATE_FAILED"; printf '%s\n' "$MOVE_ERROR" | tail -n 3 | sed 's/^/    /'; return 1 ;;
    esac
    chmod +x "$SCRIPT_DIR"/*.sh "$SCRIPT_DIR/keepalive"
    # The new code, not this one already in memory, brings what the install keeps up to date.
    bash "$SCRIPT_DIR/keepalive" migrate
    after=$(_version)
    ui_ok "$(printf "$T_UPDATED" "$before" "$after")"
    [[ -n "$STASHED" ]] && ui_note "$T_STASHED"
    return 0
}

changelog() {
    local current newer
    current=$(installed_version)
    ui_section "$T_CL_TITLE"
    if [[ -n "$current" ]]; then
        printf '\n  %s\n' "$(printf "$T_CL_INSTALLED" "$current")"
    else
        printf '\n  %s\n' "$T_CL_BARE"
    fi
    newer=$(newer_version) && ui_warn "$(printf "$T_CL_NEWER" "$newer")"
    echo ""
    _changes_table "" "$current" < "$SCRIPT_DIR/CHANGELOG.md"
    ui_note "$T_CL_NOTE"
}

migrate() {
    migrate_token
    write_crontab
}

_agent_version() { "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1; }

# Every agent CLI to its latest version. A Claude installed in ~/.local/bin updates itself; the rest are npm
# packages, global ones needing sudo. An agent that is running is left alone, as the cron's send could be it.
update_agents() {
    local agent package before after answer prefix sudo=()
    ui_section "$T_UPGRADE_TITLE"
    printf '\n  %s\n\n' "$T_UPGRADE_NOTE"
    prefix=$(npm prefix -g 2>/dev/null)
    if [[ -n "$prefix" && ! -w "$prefix/lib" ]]; then
        sudo=(sudo)
        sudo -n true 2>/dev/null || ui_note "$T_NEEDS_SUDO"
    fi
    for agent in $AGENTS_KNOWN; do
        agent_installed "$agent" || continue
        package=$(agent_package "$agent")
        if pgrep -u "$(id -u)" -f "(^|/)$agent( |\$)|$package" >/dev/null 2>&1; then
            ui_warn "$(printf "$T_BUSY" "$(agent_title "$agent")")"
            continue
        fi
        before=$(_agent_version "$agent")
        printf '  %s\r' "$(printf "$T_UPGRADING" "$(agent_title "$agent")")"
        if [[ "$agent" == claude && "$(command -v claude)" == "$HOME/.local/bin/claude" ]]; then
            answer=$(timeout 300 claude update 2>&1)
        else
            answer=$(timeout 600 "${sudo[@]}" npm install -g "$package@latest" 2>&1)
        fi
        local code=$?
        hash -r
        after=$(_agent_version "$agent")
        printf '\033[2K'
        if (( code != 0 )); then
            ui_fail "$(printf "$T_UPGRADE_FAILED" "$(agent_title "$agent")")"
            printf '%s\n' "$answer" | grep -v '^[[:space:]]*$' | tail -n 3 | cut -c1-110 | sed 's/^/    /'
        elif [[ "$before" == "$after" ]]; then
            ui_ok "$(printf "$T_SAME" "$(agent_title "$agent")" "${after:-?}")"
        else
            ui_ok "$(printf "$T_UPGRADED" "$(agent_title "$agent")" "${before:-?}" "${after:-?}")"
        fi
    done
    echo ""
}

# ── Menu ──────────────────────────────────────────────────────────────────────
# The person's terminal, with `menu` to come back. Their own startup files still run.
_terminal() {
    ui_clear
    ui_section "$T_TERMINAL_TITLE"
    printf '\n  %s\n\n' "$T_TERMINAL_BACK"
    KEEPALIVE_NOTICE="" bash --rcfile "$SCRIPT_DIR/terminal-rc.sh" -i
}

_then_pause() {  # runs an action and waits before the menu comes back, unless the person went back from it
    "$@"
    (( $? == BACK )) || ui_pause
}

menu() {
    [[ -t 0 && -t 1 ]] || { status; return; }
    local notice newer
    notice=$(printf '%s' "${KEEPALIVE_NOTICE:-}" | base64 -d 2>/dev/null)
    check_update --if-stale >/dev/null 2>&1 &
    while true; do
        load_config
        ui_clear
        [[ -n "$notice" ]] && printf '%s\n' "$notice"
        notice=""
        _overview brief
        ui_group "$T_G_SESSIONS"
        ui_option 1 "$T_M_TEST"
        ui_option 2 "$T_M_LOG"
        ui_option 3 "$T_M_SCHEDULE"
        ui_group "$T_G_ACCOUNTS"
        ui_option 4 "$T_M_LOGIN"
        ui_option 5 "$T_M_LOGOUT"
        ui_group "$T_G_UPDATE"
        ui_option 6 "$T_M_UPGRADE"
        if newer=$(newer_version); then
            ui_option 7 "$C_YELLOW$(printf "$T_M_UPDATE_TO" "$newer")$C_RESET"
        else
            ui_option 7 "$T_M_UPDATE"
        fi
        ui_group "$T_G_TERMINAL"
        ui_option 8 "$T_M_TERMINAL"
        echo ""
        ui_option 0 "${KEEPALIVE_EXIT_LABEL:-$T_M_EXIT}"
        ui_choose "$U_PICK" 8 || return 0
        case "$ANSWER" in
            0) return 0 ;;
            1) ui_clear; _then_pause bash "$SCRIPT_DIR/test.sh" --ask ;;
            2) ui_clear; _then_pause history ;;
            3) bash "$SCRIPT_DIR/update-schedule.sh" ;;
            4) _then_pause login ;;
            5) _then_pause logout ;;
            6) ui_clear; _then_pause update_agents ;;
            7)
                ui_clear
                update
                if (( $? == 0 )); then
                    ui_note "$T_REOPEN"
                    ui_pause
                    KEEPALIVE_NOTICE="" exec bash "$SCRIPT_DIR/keepalive" menu
                fi
                ui_pause ;;
            8) _terminal ;;
        esac
    done
}

_help() {
    cat <<'HELP'
  keepalive                  abre el menú, con todas las opciones y una terminal
  keepalive status           el horario, el próximo envío y cada agente con su cuenta y su último envío
  keepalive login [agente]   conecta un agente, Claude con un token que dura un año
  keepalive logout [agente]  cierra la sesión de un agente en esta máquina, y con --yes no pregunta
  keepalive schedule         cambia los días, las horas y los agentes de la sesión automática
  keepalive test             hace un envío real a cada agente y revisa el resultado
  keepalive log [agente]     muestra los últimos envíos
  keepalive update           muestra lo que trae la versión más reciente y la baja sin tocar tu horario
  keepalive changelog        muestra los cambios de la versión que tienes y de las anteriores
  keepalive update-agents    actualiza Claude Code, Codex y OpenCode sin tocar sus sesiones
  keepalive uninstall        quita el cron, la configuración y el comando
HELP
}

case "${1:-}" in
    ""|menu) menu ;;
    status) status ;;
    login) login "${2:-}" ;;
    logout) shift; logout "$@"; code=$?; (( code == BACK )) && code=0; exit "$code" ;;
    schedule) exec bash "$SCRIPT_DIR/update-schedule.sh" ;;
    test) exec bash "$SCRIPT_DIR/test.sh" ;;
    log|history) history "${2:-}" ;;
    update) update "${2:-}"; (( $? == 1 )) && exit 1; exit 0 ;;
    changelog) changelog ;;
    migrate) migrate ;;
    update-agents) update_agents ;;
    install) exec bash "$SCRIPT_DIR/install.sh" ;;
    uninstall) exec bash "$SCRIPT_DIR/uninstall.sh" ;;
    -h|--help|help) _help ;;
    *) printf "$T_UNKNOWN_COMMAND\n" "$1"; exit 1 ;;
esac
